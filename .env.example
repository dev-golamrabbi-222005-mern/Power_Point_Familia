# ==============================================================================
# Power Point Familia (PPF) - Environment Variables Configuration Template
# NOTE: Never commit sensitive production credentials or secrets to version control.
# Copy this file to `.env` or `.env.local` for local development.
# ==============================================================================

# 1. Database Connection (MongoDB)
MONGODB_URI="mongodb+srv://<db_user>:<db_password>@cluster.mongodb.net/ppf_database?retryWrites=true&w=majority"

# 2. Application & JWT Security
JWT_SECRET="your_strong_random_jwt_secret_32_characters_long"
DEFAULT_ADMIN_EMAIL="admin@powerpointfamilia.com"

# 3. NextAuth & Google OAuth Credentials
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_session_secret_key"
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# 4. Web Push Notification (VAPID Configuration)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_public_vapid_key_string"
VAPID_PRIVATE_KEY="your_private_vapid_key_string"
VAPID_SUBJECT="mailto:admin@powerpointfamilia.com"

